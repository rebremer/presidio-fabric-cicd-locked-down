# Place pre-downloaded `.whl` files here for DEP-protected workspaces.
#
# Workflow (run on a machine WITH internet access):
#   pip download \
#     --dest ./CustomLibraries \
#     --only-binary=:all: \
#     --python-version 3.11 \
#     --platform manylinux2014_x86_64 \
#     presidio-analyzer==2.2.355 presidio-anonymizer==2.2.355 \
#     spacy==3.7.5
#
# Then add the spaCy model wheel:
#   curl -L -o ./CustomLibraries/en_core_web_lg-3.7.1-py3-none-any.whl \
#     https://github.com/explosion/spacy-models/releases/download/en_core_web_lg-3.7.1/en_core_web_lg-3.7.1-py3-none-any.whl
#
# Commit the wheels and remove `requirements.txt` / the `pip:` block in
# `environment.yml` so Fabric does NOT try to reach pypi.org at build time.
